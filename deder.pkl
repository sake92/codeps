amends "https://sake92.github.io/deder/config/v0.20.0/DederProject.pkl"
import "https://sake92.github.io/deder-plugins/config/deder-web-dashboard/early-access/WebDashboardPlugin.pkl" as WD
import "https://sake92.github.io/deder-plugins/config/deder-openapi4s/early-access/Openapi4sPlugin.pkl" as OA

repositories {
  new MavenRepository { url = "https://central.sonatype.com/repository/maven-snapshots" }
}

plugins {
  new OA.Openapi4sPlugin {
    config {
      defaults {
        basePackage = "ba.sake.codeps.artifacts"
        framework = "none"
        version = "0.9.0-16-9f89a2-SNAPSHOT"
        input = "../../docs/static/schemas"
        targetDir = "src"
      }
    }
  }
  new WD.WebDashboardPlugin {
    // version = "1.2.3" // optionally override version
    config { // most plugins have some config

    }
  }
}

local const baseModule: ScalaModule = new {
  scalaVersion = "3.7.4"
  publish = false
}

local const coreModules = new CreateScalaModules {
  root = "modules/core"
  id = "core"
  template = (baseModule) {
    deps {
      "com.lihaoyi::fansi:0.5.1"
      "ba.sake::tupson:0.20.0"
      "ba.sake::validson:0.19.0"
      "com.vladsch.flexmark:flexmark:0.64.8"
      "com.vladsch.flexmark:flexmark-ext-tables:0.64.8"
    }
  }
  testTemplate = (template.asTest()) {
    junitXmlReport {
      enabled = true
    }
    deps {
      "org.scalameta::munit:1.3.4"
    }
  }
}.get

local const testUtils = (baseModule) {
  id = "test-utils"
  root = "modules/test-utils"
  moduleDeps { coreModules.main }
  deps {
    "com.lihaoyi::os-lib:0.11.8"
  }
}

local const parserSemanticdbModules = new CreateScalaModules {
  root = "modules/parser-semanticdb"
  id = "parser-semanticdb"
  template = (baseModule) {
    moduleDeps { coreModules.main }
    deps {
      "org.scalameta::semanticdb-shared:4.17.2"
    }
  }
  testTemplate = (template.asTest()) {
    junitXmlReport {
      enabled = true
    }
    moduleDeps { testUtils }
    deps {
      "org.scalameta::munit:1.3.4"
    }
  }
}.get

local const parserJdepsModules = new CreateScalaModules {
  root = "modules/parser-jdeps"
  id = "parser-jdeps"
  template = (baseModule) {
    moduleDeps { coreModules.main }
  }
  testTemplate = (template.asTest()) {
    junitXmlReport {
      enabled = true
    }
    moduleDeps { testUtils }
    deps {
      "org.scalameta::munit:1.3.4"
    }
  }
}.get

local const cliModules = new CreateScalaModules {
  root = "modules/cli"
  id = "cli"
  template = (baseModule) {
    moduleDeps {
      coreModules.main
      parserSemanticdbModules.main
      parserJdepsModules.main
    }
    deps {
      "com.lihaoyi::mainargs:0.7.8"
      "com.lihaoyi::os-lib:0.11.8"
      "org.yaml:snakeyaml:2.3"
    }
    mainClass = "ba.sake.codeps.cli.Main"
    pomSettings {
      groupId = "ba.sake"
      artifactId = "codeps-cli"
      version = read?("env:VERSION")
    }
  }
  testTemplate = (template.asTest()) {
    junitXmlReport {
      enabled = true
    }
    moduleDeps { testUtils }
    deps {
      "org.scalameta::munit:1.3.4"
      "com.networknt:json-schema-validator:1.5.9"
    }
  }
}.get

modules {
  ...coreModules.all
  ...parserSemanticdbModules.all
  ...parserJdepsModules.all
  ...cliModules.all
  testUtils
}
