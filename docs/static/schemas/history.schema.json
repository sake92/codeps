{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sake92.github.io/codeps/schemas/history.schema.json",
  "title": "HealthHistoryEntry",
  "description": "Codeps health history entry v6",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 6
    },
    "at": {
      "type": "string",
      "format": "date-time"
    },
    "commit": {
      "type": "string"
    },
    "packages": {
      "$ref": "definitions.schema.json#/$defs/healthSnapshot"
    },
    "files": {
      "anyOf": [
        {
          "$ref": "definitions.schema.json#/$defs/healthSnapshot"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schemaVersion",
    "at",
    "commit",
    "packages"
  ]
}
