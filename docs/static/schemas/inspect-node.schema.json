{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sake92.github.io/codeps/schemas/inspect-node.schema.json",
  "title": "NodeInspection",
  "description": "Codeps node inspection",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "surface": {
      "$ref": "definitions.schema.json#/$defs/surface"
    },
    "cycleId": {
      "type": [
        "string",
        "null"
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "definitions.schema.json#/$defs/finding"
      }
    }
  },
  "required": [
    "id",
    "surface",
    "cycleId",
    "findings"
  ]
}
