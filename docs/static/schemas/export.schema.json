{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sake92.github.io/codeps/schemas/export.schema.json",
  "title": "ExportGraph",
  "description": "Codeps export format",
  "type": "object",
  "properties": {
    "packages": {
      "type": "object",
      "properties": {
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "definitions.schema.json#/$defs/packageNode"
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "$ref": "definitions.schema.json#/$defs/edge"
          }
        }
      },
      "required": [
        "nodes",
        "edges"
      ]
    },
    "files": {
      "type": "object",
      "properties": {
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "definitions.schema.json#/$defs/fileNode"
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "$ref": "definitions.schema.json#/$defs/edge"
          }
        }
      },
      "required": [
        "nodes",
        "edges"
      ]
    }
  },
  "required": [
    "packages",
    "files"
  ]
}
